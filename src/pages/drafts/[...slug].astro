---
export const prerender = false;

import { getEntry, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';

const { slug } = Astro.params;
const cleanSlug = (slug || '').replace(/^\/|\/$/g, '');

const entry = await getEntry('posts', cleanSlug);
if (!entry) {
  return Astro.redirect('/', 302);
}

// If already published, redirect to canonical article
if (!entry.data.draft) {
  return Astro.redirect(`/${cleanSlug}/`, 301);
}

const { Content, headings } = await render(entry);
---

<PostLayout
  title={entry.data.title}
  published={entry.data.published}
  slug={cleanSlug}
  description={entry.data.description}
  keywords={entry.data.keywords}
  cover={entry.data.cover}
  coverTitle={entry.data.coverTitle}
  draft={true}
  toc={entry.data.toc}
  headings={headings}
>
  <div class="mb-8 p-3.5 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-300 dark:border-emerald-800/80 text-emerald-800 dark:text-emerald-300 text-xs font-semibold flex items-center justify-between shadow-sm">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span>Authenticated Admin Preview</span>
    </div>
    <span class="font-mono text-[11px] px-2 py-0.5 rounded-full bg-emerald-100 dark:bg-emerald-900/60 border border-emerald-200 dark:border-emerald-700">
      draft: true
    </span>
  </div>

  <Content />
</PostLayout>
