---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';

const drafts = await getCollection('posts', ({ data }) => Boolean(data.draft));
const sortedDrafts = drafts.sort((a, b) => {
  const dateA = a.data.published ? new Date(a.data.published).getTime() : 0;
  const dateB = b.data.published ? new Date(b.data.published).getTime() : 0;
  return dateB - dateA;
});
---

<!-- Instant client fast-fail: if not logged in, redirect directly to homepage -->
<script is:inline>
  if (typeof document !== 'undefined' && !document.cookie.includes('__session')) {
    window.location.replace('/');
  }
</script>

<BaseLayout
  title="Private Drafts Index"
  description="Admin preview index for unpublished drafts"
  noindex={true}
>
  <!-- Hidden by default until Admin authentication is verified -->
  <div id="draft-index-content" class="hidden max-w-3xl mx-auto py-6">
    <!-- Header -->
    <div class="mb-10 pb-6 border-b border-neutral-200 dark:border-neutral-800 flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-white flex items-center gap-2.5">
          <span>Unpublished Drafts</span>
          <span class="px-2 py-0.5 text-xs font-mono font-semibold rounded-full bg-amber-100 dark:bg-amber-950 text-amber-800 dark:text-amber-300 border border-amber-300 dark:border-amber-800">
            {sortedDrafts.length}
          </span>
        </h1>
        <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">
          Private drafts deployed to Cloudflare Pages for review before publishing.
        </p>
      </div>

      <a
        href="/"
        class="text-xs font-medium text-neutral-500 hover:text-sky-600 dark:text-neutral-400 dark:hover:text-sky-400 transition-colors"
      >
        ← Back to Blog
      </a>
    </div>

    <div class="space-y-4">
      <div class="p-3 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-300 dark:border-emerald-800/80 text-emerald-800 dark:text-emerald-300 text-xs font-semibold flex items-center justify-between">
        <span class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Admin Authenticated</span>
        </span>
        <span class="text-[11px] text-neutral-500 dark:text-neutral-400">
          Robots Disallowed (noindex, nofollow)
        </span>
      </div>

      {sortedDrafts.length === 0 ? (
        <div class="p-8 text-center rounded-2xl border border-neutral-200 dark:border-neutral-800 text-neutral-500 text-sm">
          No unpublished drafts currently in queue.
        </div>
      ) : (
        <ul class="divide-y divide-neutral-200 dark:divide-neutral-800 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/60 overflow-hidden shadow-sm">
          {sortedDrafts.map((post) => {
            const cleanSlug = post.id.replace(/\.md$/, '');
            return (
              <li class="p-5 hover:bg-neutral-50 dark:hover:bg-neutral-800/50 transition-colors">
                <a href={`/drafts/${cleanSlug}`} class="block group">
                  <div class="flex items-center justify-between gap-4 mb-1">
                    <h2 class="text-base font-bold text-neutral-900 dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors">
                      {post.data.title}
                    </h2>
                    <span class="px-2 py-0.5 text-[10px] font-mono font-bold rounded bg-amber-100 dark:bg-amber-950 text-amber-800 dark:text-amber-300 border border-amber-300 dark:border-amber-800 flex-shrink-0">
                      draft
                    </span>
                  </div>
                  {post.data.description && (
                    <p class="text-xs text-neutral-500 dark:text-neutral-400 line-clamp-2 mb-2">
                      {post.data.description}
                    </p>
                  )}
                  <div class="text-[11px] text-neutral-400 font-mono flex items-center gap-3">
                    <span>Slug: /drafts/{cleanSlug}</span>
                    {post.data.published && (
                      <span>• Target: <FormattedDate date={post.data.published} /></span>
                    )}
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      )}
    </div>
  </div>
</BaseLayout>

<script>
  import { initClerk, getClerkUser } from '../../lib/clerk';

  const contentEl = document.getElementById('draft-index-content');

  async function checkAdmin() {
    try {
      const clerk = await initClerk();
      const user = getClerkUser(clerk);
      if (user && user.isAdmin) {
        contentEl?.classList.remove('hidden');
      } else {
        // Not authorized or not admin: redirect immediately to homepage
        window.location.replace('/');
      }
    } catch (e) {
      window.location.replace('/');
    }
  }

  checkAdmin();
</script>
