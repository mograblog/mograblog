---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  image?: string;
  containerClass?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
}

const {
  title,
  description = "Guy Mograbi's Tech Blog - Let's make it work!",
  keywords = 'javascript, cloud, devops, programming, architecture',
  image = '/images/brand/logo-woodworking-craft.jpg',
  containerClass = 'max-w-4xl',
  type = 'website',
  publishedTime,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://www.mograblog.com');
const ogImageUrl = new URL(image, canonicalURL).href;

const isHomePage = canonicalURL.pathname === '/' || canonicalURL.pathname === '';
const clerkPublishableKey = import.meta.env.PUBLIC_CLERK_PUBLISHABLE_KEY || '';

const websiteSchema = isHomePage
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebSite',
          '@id': 'https://www.mograblog.com/#website',
          url: 'https://www.mograblog.com',
          name: 'Mograblog',
          alternateName: ["Guy Mograbi's Tech Blog", "Mograblog - Let's make it work!"],
          description: description,
          publisher: {
            '@id': 'https://www.mograblog.com/#organization',
          },
          inLanguage: 'en-US',
        },
        {
          '@type': 'Organization',
          '@id': 'https://www.mograblog.com/#organization',
          name: 'Mograblog',
          url: 'https://www.mograblog.com',
          logo: {
            '@type': 'ImageObject',
            url: 'https://www.mograblog.com/favicon.png',
            width: 512,
            height: 512,
          },
          sameAs: [
            'https://github.com/GuyMograbi',
            'https://twitter.com/guymograbi',
            'https://www.linkedin.com/in/guymograbi',
          ],
        },
        {
          '@type': 'ItemList',
          itemListElement: [
            {
              '@type': 'SiteNavigationElement',
              position: 1,
              name: 'Articles',
              description: 'Latest technical articles, system design guides, and tutorials.',
              url: 'https://www.mograblog.com/',
            },
            {
              '@type': 'SiteNavigationElement',
              position: 2,
              name: 'Tags & Topics',
              description: 'Explore articles by technology tag: JavaScript, Cloud, AI, and more.',
              url: 'https://www.mograblog.com/tags',
            },
            {
              '@type': 'SiteNavigationElement',
              position: 3,
              name: 'About',
              description: 'About Guy Mograbi and the Mograblog engineering journey.',
              url: 'https://www.mograblog.com/about',
            },
            {
              '@type': 'SiteNavigationElement',
              position: 4,
              name: 'Privacy Policy',
              description: 'Privacy policy and terms of Mograblog.',
              url: 'https://www.mograblog.com/privacy',
            },
          ],
        },
      ],
    }
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Mograblog</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Mograblog RSS Feed" href="/rss.xml" />

    {websiteSchema && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteSchema)} />
    )}

    <!-- Open Graph / Facebook / Slack / WhatsApp / LinkedIn -->
    <meta property="og:type" content={type} />
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {type === 'article' && (
      <meta property="article:author" content="Guy Mograbi" />
    )}
    <meta property="og:site_name" content="Mograblog" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={`${title} | Mograblog`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:alt" content="Mograblog" />

    <!-- Twitter & Slack Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL.href} />
    <meta name="twitter:title" content={`${title} | Mograblog`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Clerk Authentication SDK -->
    <script
      async
      crossorigin="anonymous"
      data-clerk-publishable-key={clerkPublishableKey}
      src="https://clerk.mograblog.com/npm/@clerk/clerk-js@latest/dist/clerk.browser.js"
      type="text/javascript"
    ></script>

    <!-- Microsoft Clarity Analytics -->
    <script type="text/javascript" is:inline>
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "yiwitf4e9j");
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Inline Script to prevent Theme Flash & Auto Detect System Theme -->
    <script is:inline>
      function applyTheme() {
        const saved = typeof localStorage !== 'undefined' ? localStorage.getItem('theme') : null;
        const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        
        if (saved === 'dark' || (!saved && systemPrefersDark)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      }

      applyTheme();

      // Listen for OS / Browser theme change in real-time
      if (typeof window !== 'undefined') {
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
          if (!localStorage.getItem('theme')) {
            if (e.matches) {
              document.documentElement.classList.add('dark');
            } else {
              document.documentElement.classList.remove('dark');
            }
          }
        });
      }
    </script>
  </head>
  <body class="bg-[#fbfbfb] dark:bg-[#09090b] text-neutral-900 dark:text-neutral-100 min-h-screen flex flex-col selection:bg-sky-500/20 selection:text-sky-600 dark:selection:text-sky-400">
    <Header />
    <main class={`flex-grow ${containerClass} w-full mx-auto px-4 sm:px-6 py-8 sm:py-12`}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
