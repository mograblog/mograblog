---
// Component: HomeLiveReading
// Displays real-time reading activity across the blog on the homepage.
---

<section id="home-live-reading-section" class="mb-14 p-5 sm:p-6 rounded-3xl border border-neutral-200/80 dark:border-neutral-800/80 bg-neutral-50/60 dark:bg-neutral-900/30 backdrop-blur shadow-sm">
  <!-- Section Header -->
  <div class="flex items-center justify-between gap-4 mb-5 pb-3 border-b border-neutral-200/60 dark:border-neutral-800/60">
    <div class="flex items-center gap-2.5">
      <span class="relative flex h-2.5 w-2.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
      </span>
      <div>
        <h2 class="text-base sm:text-lg font-bold tracking-tight text-neutral-900 dark:text-white">
          What People Are Reading Right Now
        </h2>
        <p class="text-xs text-neutral-500 dark:text-neutral-400">
          Live visitor activity and popular deep dives
        </p>
      </div>
    </div>

    <span class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 border border-emerald-200/60 dark:border-emerald-800/60">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
      Live Feed
    </span>
  </div>

  <!-- Cards Grid -->
  <div id="home-live-reading-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5">
    <!-- Skeleton Loaders -->
    {Array.from({ length: 6 }).map(() => (
      <div class="p-3.5 rounded-2xl border border-neutral-200/60 dark:border-neutral-800/60 bg-white/40 dark:bg-neutral-900/40 animate-pulse space-y-2.5">
        <div class="h-4 bg-neutral-200 dark:bg-neutral-800 rounded w-4/5"></div>
        <div class="h-3 bg-neutral-200 dark:bg-neutral-800 rounded w-2/3"></div>
        <div class="flex justify-between pt-1">
          <div class="h-2.5 bg-neutral-200 dark:bg-neutral-800 rounded w-1/4"></div>
          <div class="h-2.5 bg-neutral-200 dark:bg-neutral-800 rounded w-1/4"></div>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  function formatRelativeTime(dateStr: string) {
    if (!dateStr) return 'recently';
    const now = new Date().getTime();

    let normalized = dateStr;
    if (!normalized.includes('T')) {
      normalized = normalized.replace(' ', 'T') + 'Z';
    } else if (!normalized.endsWith('Z') && !normalized.includes('+')) {
      normalized = normalized + 'Z';
    }

    const then = new Date(normalized).getTime();
    let diffSec = Math.floor((now - then) / 1000);
    if (isNaN(diffSec) || diffSec < 0) diffSec = 0;

    if (diffSec < 120) return 'right now..';
    if (diffSec < 3600) {
      const mins = Math.max(1, Math.floor(diffSec / 60));
      return `${mins} ${mins === 1 ? 'min' : 'mins'} ago`;
    }
    if (diffSec < 86400) {
      const hours = Math.floor(diffSec / 3600);
      return `${hours} ${hours === 1 ? 'hour' : 'hours'} ago`;
    }
    const days = Math.floor(diffSec / 86400);
    return `${days} ${days === 1 ? 'day' : 'days'} ago`;
  }

  function formatViews(num: number) {
    if (!num || isNaN(num)) return '';
    if (num >= 10000) {
      return `${(num / 1000).toFixed(1).replace('.0', '')}k views`;
    }
    if (num >= 1000) {
      return `${Number(num).toLocaleString()} views`;
    }
    return `${num} ${num === 1 ? 'view' : 'views'}`;
  }

  function escapeHtml(str: string) {
    return (str || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  async function loadHomeLiveReading() {
    const grid = document.getElementById('home-live-reading-grid');
    if (!grid) return;

    try {
      const res = await fetch('/api/views?limit=9');
      if (!res.ok) throw new Error('Network error');
      const data = await res.json();
      const reads = data?.recentReads;

      if (!Array.isArray(reads) || reads.length === 0) {
        const section = document.getElementById('home-live-reading-section');
        if (section) section.style.display = 'none';
        return;
      }

      grid.innerHTML = reads.slice(0, 6).map((item: any) => {
        const relTime = formatRelativeTime(item.created_at);
        const viewsBadge = item.views_count ? formatViews(item.views_count) : '';
        const cleanUrl = item.post_slug.startsWith('/') ? item.post_slug : `/${item.post_slug}`;
        const title = item.post_title || item.post_slug;

        return `
          <a
            href="${escapeHtml(cleanUrl)}"
            class="group p-3.5 rounded-2xl border border-neutral-200/80 dark:border-neutral-800/80 bg-white/70 dark:bg-neutral-900/50 hover:bg-white dark:hover:bg-neutral-900 hover:border-sky-400/50 dark:hover:border-sky-500/40 hover:shadow-md transition-all flex flex-col justify-between text-left"
          >
            <div>
              <div class="text-xs sm:text-[13px] font-semibold text-neutral-900 dark:text-neutral-100 group-hover:text-sky-600 dark:group-hover:text-sky-400 leading-snug line-clamp-2 transition-colors">
                ${escapeHtml(title)}
              </div>
            </div>

            <div class="flex items-center justify-between text-[11px] text-neutral-400 dark:text-neutral-500 mt-3 pt-2.5 border-t border-neutral-100 dark:border-neutral-800/60">
              <span class="inline-flex items-center gap-1">
                <svg class="w-3 h-3 text-neutral-400 dark:text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>${escapeHtml(relTime)}</span>
              </span>

              ${viewsBadge ? `
                <span class="inline-flex items-center gap-1 font-medium text-neutral-500 dark:text-neutral-400">
                  <svg class="w-3 h-3 text-neutral-400 dark:text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                  </svg>
                  <span>${escapeHtml(viewsBadge)}</span>
                </span>
              ` : ''}
            </div>
          </a>
        `;
      }).join('');
    } catch (e) {
      console.warn('Failed to load homepage live reading:', e);
      const section = document.getElementById('home-live-reading-section');
      if (section) section.style.display = 'none';
    }
  }

  loadHomeLiveReading();
  document.addEventListener('astro:after-swap', loadHomeLiveReading);
</script>
