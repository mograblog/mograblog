---
interface Props {
  quote?: string;
  author?: string;
  id?: string;
  class?: string;
}

const { quote, author, id, class: className = '' } = Astro.props;
---

<blockquote class={`quote-highlight-card ${className}`} id={id ? `quote-${id}` : undefined}>
  <div class="quote-highlight text-xl sm:text-2xl font-bold text-neutral-900 dark:text-white not-italic" data-quote-id={id}>
    {quote || <slot />}
  </div>
  {author && (
    <cite class="block mt-2 text-sm text-neutral-500 dark:text-neutral-400 not-italic">
      — {author}
    </cite>
  )}
</blockquote>
