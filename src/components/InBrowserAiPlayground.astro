<script>
  let transformersModule: any = null;
  let kokoroModule: any = null;
  let llmPipeline: any = null;
  let currentLoadedModelId: string | null = null;
  let speecht5Pipeline: any = null;
  let kokoroInstance: any = null;

  async function getTransformers() {
    if (transformersModule) return transformersModule;
    if (typeof (window as any).Float16Array === 'undefined') {
      (window as any).Float16Array = (window as any).Uint16Array;
    }
    transformersModule = await import('https://cdn.jsdelivr.net/npm/@huggingface/transformers@3.3.3/+esm');
    return transformersModule;
  }

  async function getKokoroModule() {
    if (kokoroModule) return kokoroModule;
    kokoroModule = await import('https://cdn.jsdelivr.net/npm/kokoro-js@1.2.1/dist/kokoro.web.js');
    return kokoroModule;
  }

  async function updateStorageEstimate() {
    const textEls = document.querySelectorAll('.storage-usage-text');
    if (!textEls.length) return;
    if (navigator.storage && navigator.storage.estimate) {
      try {
        const estimate = await navigator.storage.estimate();
        const mb = ((estimate.usage || 0) / (1024 * 1024)).toFixed(1);
        textEls.forEach((el) => { el.textContent = `${mb} MB cached`; });
      } catch (e) {
        textEls.forEach((el) => { el.textContent = 'Active'; });
      }
    } else {
      textEls.forEach((el) => { el.textContent = 'Ready'; });
    }
  }

  async function purgeAllAiStorage() {
    try {
      if ('caches' in window) {
        const keys = await caches.keys();
        for (const k of keys) {
          if (k.includes('transformers') || k.includes('onnx') || k.includes('imgly') || k.includes('kokoro')) {
            await caches.delete(k);
          }
        }
      }

      if (window.indexedDB && indexedDB.databases) {
        const dbs = await indexedDB.databases();
        for (const db of dbs) {
          if (db.name && (db.name.includes('transformers') || db.name.includes('onnx') || db.name.includes('keyval'))) {
            indexedDB.deleteDatabase(db.name);
          }
        }
      }

      llmPipeline = null;
      currentLoadedModelId = null;
      speecht5Pipeline = null;
      kokoroInstance = null;

      const textEls = document.querySelectorAll('.storage-usage-text');
      textEls.forEach((el) => { el.textContent = '0 MB (Purged!)'; });

      alert('All downloaded neural weights and local caches have been wiped from your browser!');
      await updateStorageEstimate();
    } catch (e) {
      console.error('Error purging cache:', e);
      alert('Cache cleared!');
      await updateStorageEstimate();
    }
  }

  const KOKORO_VOICES = [
    { id: 'af_heart', label: '❤️ Heart — US Female (Warm & Natural)' },
    { id: 'af_bella', label: '🔥 Bella — US Female (Expressive)' },
    { id: 'af_nicole', label: '🎧 Nicole — US Female (Clear & Calm)' },
    { id: 'am_adam', label: '🎙️ Adam — US Male (Deep & Resonant)' },
    { id: 'am_michael', label: '💬 Michael — US Male (Conversational)' },
    { id: 'bf_emma', label: '🇬🇧 Emma — British Female' },
    { id: 'bm_george', label: '🇬🇧 George — British Male' },
  ];

  const SPEECHT5_VOICES = [
    { id: 'https://huggingface.co/datasets/Xenova/cmu-arctic-xvectors-extracted/resolve/main/cmu_us_slt_arctic-wav-arctic_a0001.bin', label: '👩 Stephanie — US Female (Clear)' },
    { id: 'https://huggingface.co/datasets/Xenova/cmu-arctic-xvectors-extracted/resolve/main/cmu_us_bdl_arctic-wav-arctic_a0001.bin', label: '👨 Brian — US Male (Deep & Baritone)' },
    { id: 'https://huggingface.co/datasets/Xenova/cmu-arctic-xvectors-extracted/resolve/main/cmu_us_clb_arctic-wav-arctic_a0001.bin', label: '👩 Carol — US Female 2 (Warm)' },
    { id: 'https://huggingface.co/datasets/Xenova/cmu-arctic-xvectors-extracted/resolve/main/cmu_us_rms_arctic-wav-arctic_a0001.bin', label: '👨 Richard — US Male 2 (Crisp)' },
    { id: 'https://huggingface.co/datasets/Xenova/cmu-arctic-xvectors-extracted/resolve/main/cmu_us_awb_arctic-wav-arctic_a0001.bin', label: '🏴󠁧󠁢󠁳󠁣󠁴󠁿 Alistair — Scottish Male' },
  ];

  function setupAiPlayground() {
    // Mount Demo 1: LLM Card
    const llmCard = document.getElementById('ai-llm-card');
    const llmMount = document.getElementById('live-llm-mount');
    if (llmCard && llmMount && llmCard.parentElement !== llmMount) {
      llmMount.appendChild(llmCard);
      llmCard.classList.remove('hidden');
    }

    // Mount Demo 2: TTS Card
    const ttsCard = document.getElementById('ai-tts-card');
    const ttsMount = document.getElementById('live-tts-mount');
    if (ttsCard && ttsMount && ttsCard.parentElement !== ttsMount) {
      ttsMount.appendChild(ttsCard);
      ttsCard.classList.remove('hidden');
    }

    updateStorageEstimate();

    // Hook Purge Buttons on both cards
    document.querySelectorAll('.btn-purge-storage').forEach((btn) => {
      btn.addEventListener('click', purgeAllAiStorage);
    });

    // LLM Presets
    document.querySelectorAll('.preset-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const text = btn.getAttribute('data-text');
        const input = document.getElementById('llm-prompt-input') as HTMLTextAreaElement | null;
        if (input && text) {
          input.value = text;
          input.focus();
        }
      });
    });

    // TTS Presets
    document.querySelectorAll('.tts-preset-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const text = btn.getAttribute('data-text');
        const input = document.getElementById('tts-text-input') as HTMLInputElement | null;
        if (input && text) {
          input.value = text;
          input.focus();
        }
      });
    });

    // LLM Elements
    const btnRunLlm = document.getElementById('btn-run-llm');
    const btnRunLlmText = document.getElementById('btn-run-llm-text');
    const llmPrompt = document.getElementById('llm-prompt-input') as HTMLTextAreaElement | null;
    const llmOutput = document.getElementById('llm-output-box');
    const llmProgress = document.getElementById('llm-progress-container');
    const llmStatus = document.getElementById('llm-progress-status');
    const llmPercent = document.getElementById('llm-progress-percent');
    const llmBar = document.getElementById('llm-progress-bar');
    const llmMetrics = document.getElementById('llm-metrics');
    const modelSelect = document.getElementById('llm-model-select') as HTMLSelectElement | null;
    const modelDesc = document.getElementById('llm-model-desc');
    const modelBadge = document.getElementById('llm-model-badge');

    modelSelect?.addEventListener('change', () => {
      const selectedOption = modelSelect.options[modelSelect.selectedIndex];
      const size = selectedOption.getAttribute('data-size') || '~390 MB';
      const desc = selectedOption.getAttribute('data-desc') || '';
      if (modelDesc) modelDesc.textContent = desc;
      if (modelBadge) modelBadge.textContent = `Download: ${size}`;
      if (btnRunLlmText && !btnRunLlm?.hasAttribute('disabled')) {
        btnRunLlmText.textContent = `Generate In-Browser (${size})`;
      }
    });

    btnRunLlm?.addEventListener('click', async () => {
      const prompt = llmPrompt?.value.trim();
      if (!prompt) return;

      const selectedModelId = modelSelect?.value || 'onnx-community/Qwen2.5-0.5B-Instruct';
      const selectedOption = modelSelect?.options[modelSelect.selectedIndex];
      const modelSize = selectedOption?.getAttribute('data-size') || '~390 MB';

      if (llmPipeline && currentLoadedModelId !== selectedModelId) {
        llmPipeline = null;
        currentLoadedModelId = null;
      }

      btnRunLlm.setAttribute('disabled', 'true');
      btnRunLlm.classList.add('opacity-60');
      if (llmOutput) llmOutput.textContent = 'Preparing model...';

      try {
        const { pipeline } = await getTransformers();

        if (!llmPipeline) {
          llmProgress?.classList.remove('hidden');
          const shortName = selectedModelId.split('/')[1] || selectedModelId;
          if (llmStatus) llmStatus.textContent = `Downloading ${shortName} (${modelSize})...`;

          llmPipeline = await pipeline('text-generation', selectedModelId, {
            dtype: 'q4',
            device: 'webgpu',
            progress_callback: (p: any) => {
              if (p.status === 'progress' && p.total > 0) {
                const pct = Math.round((p.loaded / p.total) * 100);
                if (llmPercent) llmPercent.textContent = `${pct}%`;
                if (llmBar) llmBar.style.width = `${pct}%`;
                if (llmStatus) llmStatus.textContent = `Downloading ${p.file} (${pct}%)...`;
              }
            }
          }).catch(async (err: any) => {
            console.warn('WebGPU q4 init failed, trying q8/WASM fallback:', err);
            if (llmStatus) llmStatus.textContent = 'WebGPU fallback to WASM...';
            return await pipeline('text-generation', selectedModelId, {
              dtype: 'q8',
              device: 'wasm',
            });
          });

          currentLoadedModelId = selectedModelId;
          llmProgress?.classList.add('hidden');
          await updateStorageEstimate();
        }

        if (llmOutput) llmOutput.textContent = 'Generating response...\n';
        if (btnRunLlmText) btnRunLlmText.textContent = 'Running...';

        const startTime = performance.now();

        const messages = [
          { role: 'system', content: 'You are a helpful, concise assistant.' },
          { role: 'user', content: prompt }
        ];

        let formattedInput = prompt;
        if (llmPipeline.tokenizer?.apply_chat_template) {
          try {
            formattedInput = llmPipeline.tokenizer.apply_chat_template(messages, {
              tokenize: false,
              add_generation_prompt: true,
            });
          } catch (e) {
            console.warn('apply_chat_template fallback:', e);
            formattedInput = `<|im_start|>system\nYou are a helpful, concise assistant.<|im_end|>\n<|im_start|>user\n${prompt}<|im_end|>\n<|im_start|>assistant\n`;
          }
        } else {
          formattedInput = `<|im_start|>system\nYou are a helpful, concise assistant.<|im_end|>\n<|im_start|>user\n${prompt}<|im_end|>\n<|im_start|>assistant\n`;
        }

        const output = await llmPipeline(formattedInput, {
          max_new_tokens: 180,
          temperature: 0.6,
          do_sample: true,
          return_full_text: false,
        });

        const elapsedSec = ((performance.now() - startTime) / 1000).toFixed(2);
        let answer = output[0]?.generated_text || '';
        if (typeof answer !== 'string' && Array.isArray(answer)) {
          answer = answer[answer.length - 1]?.content || '';
        }

        answer = answer
          .replace(/<\|im_end\|>/g, '')
          .replace(/<\|endoftext\|>/g, '')
          .replace(/<\|im_start\|>/g, '')
          .trim();

        if (llmOutput) {
          llmOutput.textContent = answer || 'No response generated.';
        }
        if (llmMetrics) {
          llmMetrics.textContent = `Completed in ${elapsedSec}s`;
        }

      } catch (err: any) {
        console.error('LLM generation error:', err);
        if (llmOutput) llmOutput.textContent = `Error: ${err?.message || err}`;
      } finally {
        btnRunLlm.removeAttribute('disabled');
        btnRunLlm.classList.remove('opacity-60');
        if (btnRunLlmText) btnRunLlmText.textContent = 'Generate Again';
        await updateStorageEstimate();
      }
    });

    // TTS Elements
    const btnRunTts = document.getElementById('btn-run-tts');
    const btnRunTtsText = document.getElementById('btn-run-tts-text');
    const ttsInput = document.getElementById('tts-text-input') as HTMLInputElement | null;
    const ttsProgress = document.getElementById('tts-progress-container');
    const ttsStatus = document.getElementById('tts-progress-status');
    const ttsPercent = document.getElementById('tts-progress-percent');
    const ttsBar = document.getElementById('tts-progress-bar');
    const ttsContainer = document.getElementById('tts-audio-container');
    const ttsPlayer = document.getElementById('tts-audio-player') as HTMLAudioElement | null;
    const ttsTimer = document.getElementById('tts-timer-metric');
    const engineSelect = document.getElementById('tts-engine-select') as HTMLSelectElement | null;
    const voiceSelect = document.getElementById('tts-voice-select') as HTMLSelectElement | null;
    const engineDesc = document.getElementById('tts-engine-desc');
    const sizeBadge = document.getElementById('tts-size-badge');

    function populateVoices(engine: string) {
      if (!voiceSelect) return;
      voiceSelect.innerHTML = '';
      const list = engine === 'kokoro' ? KOKORO_VOICES : SPEECHT5_VOICES;
      list.forEach((v) => {
        const opt = document.createElement('option');
        opt.value = v.id;
        opt.textContent = v.label;
        voiceSelect.appendChild(opt);
      });
    }

    engineSelect?.addEventListener('change', () => {
      const engine = engineSelect.value;
      populateVoices(engine);
      if (engine === 'kokoro') {
        if (engineDesc) engineDesc.textContent = 'Kokoro: State-of-the-art 82M model with lifelike human inflections & emotion.';
        if (sizeBadge) sizeBadge.textContent = 'Download: ~90 MB';
        if (btnRunTtsText && !btnRunTts?.hasAttribute('disabled')) btnRunTtsText.textContent = 'Synthesize Audio (~90MB)';
      } else {
        if (engineDesc) engineDesc.textContent = 'SpeechT5: Classic compact model conditioning on 512-dim speaker vectors.';
        if (sizeBadge) sizeBadge.textContent = 'Download: ~35 MB';
        if (btnRunTtsText && !btnRunTts?.hasAttribute('disabled')) btnRunTtsText.textContent = 'Synthesize Audio (~35MB)';
      }
    });

    // Initialize default voices
    populateVoices('kokoro');

    btnRunTts?.addEventListener('click', async () => {
      const text = ttsInput?.value.trim();
      if (!text) return;

      const engine = engineSelect?.value || 'kokoro';
      btnRunTts.setAttribute('disabled', 'true');
      btnRunTts.classList.add('opacity-60');
      const startTime = performance.now();

      try {
        let audioBlob: Blob;

        if (engine === 'kokoro') {
          const { KokoroTTS } = await getKokoroModule();

          if (!kokoroInstance) {
            ttsProgress?.classList.remove('hidden');
            if (ttsStatus) ttsStatus.textContent = 'Downloading Kokoro-82M (~90MB)...';

            const hasWebGpu = 'gpu' in navigator;
            kokoroInstance = await KokoroTTS.from_pretrained('onnx-community/Kokoro-82M-v1.0-ONNX', {
              dtype: 'q8',
              device: hasWebGpu ? 'webgpu' : 'wasm',
              progress_callback: (p: any) => {
                if (p.status === 'progress' && p.total > 0) {
                  const pct = Math.round((p.loaded / p.total) * 100);
                  if (ttsPercent) ttsPercent.textContent = `${pct}%`;
                  if (ttsBar) ttsBar.style.width = `${pct}%`;
                  if (ttsStatus) ttsStatus.textContent = `Downloading ${p.file} (${pct}%)...`;
                }
              }
            });

            ttsProgress?.classList.add('hidden');
            await updateStorageEstimate();
          }

          if (btnRunTtsText) btnRunTtsText.textContent = 'Synthesizing voice...';
          const selectedVoice = voiceSelect?.value || 'af_heart';
          const rawAudio = await kokoroInstance.generate(text, { voice: selectedVoice });

          if (typeof rawAudio.toBlob === 'function') {
            audioBlob = await rawAudio.toBlob();
          } else {
            const samples = rawAudio.audio || rawAudio.data;
            const rate = rawAudio.sampling_rate || 24000;
            audioBlob = audioDataToWav(samples, rate);
          }

        } else {
          // SpeechT5
          const { pipeline } = await getTransformers();

          if (!speecht5Pipeline) {
            ttsProgress?.classList.remove('hidden');
            if (ttsStatus) ttsStatus.textContent = 'Downloading SpeechT5 (~35MB)...';

            speecht5Pipeline = await pipeline('text-to-speech', 'Xenova/speecht5_tts', {
              quantized: true,
              progress_callback: (p: any) => {
                if (p.status === 'progress' && p.total > 0) {
                  const pct = Math.round((p.loaded / p.total) * 100);
                  if (ttsPercent) ttsPercent.textContent = `${pct}%`;
                  if (ttsBar) ttsBar.style.width = `${pct}%`;
                  if (ttsStatus) ttsStatus.textContent = `Downloading ${p.file} (${pct}%)...`;
                }
              }
            });

            ttsProgress?.classList.add('hidden');
            await updateStorageEstimate();
          }

          if (btnRunTtsText) btnRunTtsText.textContent = 'Synthesizing voice...';
          const speaker_embeddings = voiceSelect?.value || SPEECHT5_VOICES[0].id;
          const result = await speecht5Pipeline(text, { speaker_embeddings });
          audioBlob = audioDataToWav(result.audio, result.sampling_rate || 16000);
        }

        const elapsedSec = ((performance.now() - startTime) / 1000).toFixed(2);
        const audioUrl = URL.createObjectURL(audioBlob);

        if (ttsPlayer) {
          ttsPlayer.src = audioUrl;
          ttsPlayer.play();
        }
        if (ttsTimer) {
          ttsTimer.textContent = `Synthesized in ${elapsedSec}s`;
        }
        ttsContainer?.classList.remove('hidden');

      } catch (err: any) {
        console.error('TTS error:', err);
        alert(`TTS Error: ${err?.message || err}`);
      } finally {
        btnRunTts.removeAttribute('disabled');
        btnRunTts.classList.remove('opacity-60');
        if (btnRunTtsText) btnRunTtsText.textContent = 'Synthesize Again';
        await updateStorageEstimate();
      }
    });

    // Helper: float32 audio to wav Blob
    function audioDataToWav(samples: Float32Array, sampleRate: number): Blob {
      const buffer = new ArrayBuffer(44 + samples.length * 2);
      const view = new DataView(buffer);

      function writeString(view: DataView, offset: number, string: string) {
        for (let i = 0; i < string.length; i++) {
          view.setUint8(offset + i, string.charCodeAt(i));
        }
      }

      writeString(view, 0, 'RIFF');
      view.setUint32(4, 36 + samples.length * 2, true);
      writeString(view, 8, 'WAVE');
      writeString(view, 12, 'fmt ');
      view.setUint32(16, 16, true);
      view.setUint16(20, 1, true);
      view.setUint16(22, 1, true);
      view.setUint32(24, sampleRate, true);
      view.setUint32(28, sampleRate * 2, true);
      view.setUint16(32, 2, true);
      view.setUint16(34, 16, true);
      writeString(view, 36, 'data');
      view.setUint32(40, samples.length * 2, true);

      let offset = 44;
      for (let i = 0; i < samples.length; i++, offset += 2) {
        const s = Math.max(-1, Math.min(1, samples[i]));
        view.setInt16(offset, s < 0 ? s * 0x8000 : s * 0x7FFF, true);
      }

      return new Blob([view], { type: 'audio/wav' });
    }
  }

  setupAiPlayground();
  document.addEventListener('astro:after-swap', setupAiPlayground);
</script>
