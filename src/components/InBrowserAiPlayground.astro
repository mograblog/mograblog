    <!-- Audio Output Player -->
    <div id="tts-audio-container" class="hidden mt-4 p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 flex flex-col sm:flex-row items-center justify-between gap-4">
      <audio id="tts-audio-player" controls class="w-full sm:w-auto flex-1"></audio>
      <div class="flex items-center gap-3 text-xs">
        <span id="tts-timer-metric" class="font-mono text-neutral-400"></span>
        <span class="font-semibold text-emerald-600 dark:text-emerald-400 flex items-center gap-1 flex-shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          Generated Locally
        </span>
